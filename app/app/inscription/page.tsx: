"use client"; import {useState} from "react"; export default function Ins(){const[n,setN]=useState("");const[e,setE]=useState("");const ok=()=>{const u=JSON.parse(localStorage.getItem('ssp_pending_users')||'[]');u.push({name:n,email:e,date:new Date().toLocaleString()});localStorage.setItem('ssp_pending_users',JSON.stringify(u));alert('Enskripsyon voye! PDG ap valide w');setN("");setE("")};return <div style={{padding:40,maxWidth:400,margin:'auto'}}><h1>Enskripsyon SSP</h1><input placeholder="Non w" value={n} onChange={x=>setN(x.target.value)} style={{width:'100%',padding:12,margin:'10px 0'}}/><input placeholder="Email w" value={e} onChange={x=>setE(x.target.value)} style={{width:'100%',padding:12}}/><button onClick={ok} style={{width:'100%',padding:12,marginTop:15,background:'white',color:'black'}}>Voye</button><br/><br/><a href="/" style={{color:'#aaa'}}>Retounen</a></div>}
